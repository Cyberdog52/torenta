{
  // See https://containers.dev for the spec, and
  // https://www.jetbrains.com/help/idea/connect-to-devcontainer.html for
  // connecting IntelliJ IDEA (via JetBrains Gateway) to this container.
  "name": "torenta",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "features": {
    // Java 25 (Temurin/Adoptium), matching the backend toolchain and CI.
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "tem",
      "installMaven": false,
      "installGradle": false
    },
    // Node.js for the Angular 6 frontend, which requires Node 10-16.
    // 16 is pinned here to match the ".nvmrc use"/"nvm install 16" instructions.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "16"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    }
  },

  // Backend (Spring Boot / TorentaApplication) + Frontend (Angular dev server)
  "forwardPorts": [8080, 4200],
  "portsAttributes": {
    "8080": {
      "label": "Backend (Spring Boot)",
      "onAutoForward": "notify"
    },
    "4200": {
      "label": "Frontend (Angular)",
      "onAutoForward": "openBrowser"
    }
  },

  // Make gradlew executable and install frontend deps on first create.
  // NOTE: You must still create backend/src/main/resources/application.properties
  // from the template and add your own TMDB API key - it is intentionally
  // NOT committed and NOT auto-generated here.
  "onCreateCommand": "chmod +x ./gradlew || true",
  "postCreateCommand": "if [ -d frontend ]; then cd frontend && npm install; fi",

  // Point Gradle and IntelliJ Gateway at the devcontainer-installed JDK 25.
  "remoteEnv": {
    "JAVA_HOME": "/usr/local/sdkman/candidates/java/current",
    "PATH": "/usr/local/sdkman/candidates/java/current/bin:${containerEnv:PATH}"
  },

  "remoteUser": "vscode",

  "customizations": {
    // JetBrains / IntelliJ IDEA Gateway configuration.
    "jetbrains": {
      "backend": "IntelliJ",
      "plugins": [
        "com.intellij.gradle",
        "org.jetbrains.plugins.node-remote-interpreter",
        "AngularJS"
      ]
    }
  }
}