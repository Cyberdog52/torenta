# Editor configuration, see https://editorconfig.org
# Root config for the backend and repository-level files.
# The Angular frontend has its own `frontend/.editorconfig` (root = true).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,gradle}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
